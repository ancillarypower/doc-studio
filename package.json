{
  "name": "doc-studio",
  "private": true,
  "version": "0.1.0",
  "description": "文件工坊 Doc Studio: 騎縫章、浮水印、頁碼、PDF 淨化與解密，全部在瀏覽器內完成",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base=/doc-studio/",
    "build:reference": "node reference/build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "fixtures": "node scripts/make-fixtures.mjs fixtures",
    "lint": "eslint src tests e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/make-fixtures.mjs fixtures && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/noto-sans-tc": "^5.2.0",
    "@fontsource/noto-serif-tc": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "0.27.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "react18": "npm:react@18.2.0",
    "react-dom18": "npm:react-dom@18.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.40.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
