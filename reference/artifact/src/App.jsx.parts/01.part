//      XObject；文字以定位色條呈現）逐頁背景渲染，失敗頁保留佔位卡。
// v11: preview section moved between 貳 and 參, sections renumbered 壹–陸;
//      method A renamed 摺頁橫蓋 + new method C 摺頁直蓋法 (90° pre-rotation);
//      章數 (1–5 seals per pair / strips per doc); page-number size / bottom offset / rotation;
//      generate button split into own section 陸 with a big gated green download button.
import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import DropZone from "./components/DropZone.jsx";
import Diagram from "./components/Diagram.jsx";
import { PdfDoc, PdfError, deflate } from "./pdf/pdf.js";
import { createRenderer } from "./pdf/render.js";
import { buildLabels, generateSealedPdf, LABEL_SIZE } from "./seal/generate.js";
import { labelText, textWidth, LABEL_ASCENT, LABEL_DESCENT } from "./pdf/font.js";
import { MM, planPlacement, mulberry32, labelX } from "./seal/plan.js";
import { postprocessPdf } from "./pdf/postprocess.js";
import { probeEncryption, decryptPdf } from "./pdf/crypt.js";
import { scanPdf, sanitizePdf } from "./pdf/sanitize.js";
import ScanPanel, { SAN_DEFAULT, sanDefaultsFor, sanActive, sanSummary } from "./components/ScanPanel.jsx";
import {
  loadSealCanvas, trimBlankMargins, rotateSeal, rotateQuarter, splitVertical,
  halfBoundaries, sliceBoundaries, inkCoverage, canvasToPdfImage, toGrayscale, applyOpacity,
  whiteToAlpha, hasTransparency,
} from "./seal/image.js";

const VERM = "#BE3A2B";
const INK = "#2A231A";
const MUTED = "#6E6250";
const PAPER = "#F5F0E6";
const CARD = "#FBF8F1";
const LINE = "#E3D9C6";
const GREEN = "#2A6B3A";

const MAX_PAGES = 300;
// artifact 版本號：寫入下載紀錄表頭與檔名；每次 artifact save 前同步更新
const APP_VERSION = 38;

const ALIGN_LABELS = { left: "靠左", "center-left": "中間靠左", center: "置中", "center-right": "中間靠右", right: "靠右" };
const METHOD_NAMES = { A: "摺頁橫蓋法", B: "側邊裝訂蓋章法", C: "摺頁直蓋法" };
const METHOD_SHORT = { A: "摺頁橫蓋法", B: "側邊裝訂", C: "摺頁直蓋" };
const clampRot = (v, fallback) => {
  const n = Number(v);
  if (!Number.isFinite(n)) return fallback;
  return Math.max(-45, Math.min(45, n));
};
const clampNum = (v, lo, hi, fallback) => {
  const n = Number(v);
  if (!Number.isFinite(n)) return fallback;
  return Math.max(lo, Math.min(hi, n));
};

// 目標大小：數值 + 單位 → bytes；各單位的合理範圍與預設值
const UNIT_BYTES = { MB: 1048576, KB: 1024 };
const TARGET_RANGE = { MB: [0.05, 2000, 2], KB: [50, 2048000, 2048] };
const clampTarget = (v, unit) => { const [lo, hi, d] = TARGET_RANGE[unit] || TARGET_RANGE.MB; return clampNum(v, lo, hi, d); };
const fmtTarget = (v, unit) => `${clampTarget(v, unit)} ${unit}`;

function bytesToB64(bytes) {
  let s = "";
  const chunk = 0x8000;
  for (let i = 0; i < bytes.length; i += chunk) s += String.fromCharCode(...bytes.subarray(i, i + chunk));
  return btoa(s);
}
function b64ToBytes(b64) {
  const bin = atob(b64);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}
const fmtBytes = (n) => (n > 1048576 ? (n / 1048576).toFixed(1) + " MB" : Math.max(1, Math.round(n / 1024)) + " KB");

// Shared seal pipeline: trim blank margins → downscale for speed → 去背 (a flat white
// background becomes transparent when the image carries no alpha of its own, e.g. JPG),
// so every place the seal shows — thumbnail, method cards, preview halves, the PDF itself —
// renders the background-removed image.
function prepSealCanvas(raw) {
  const trimmed = trimBlankMargins(raw);
  let canvas = trimmed.canvas;
  let downscaled = false;
  const MAXDIM = 640;
  if (canvas.width > MAXDIM || canvas.height > MAXDIM) {
    const k = MAXDIM / Math.max(canvas.width, canvas.height);
    const c = document.createElement("canvas");
    c.width = Math.round(canvas.width * k); c.height = Math.round(canvas.height * k);
    c.getContext("2d").drawImage(canvas, 0, 0, c.width, c.height);
    canvas = c; downscaled = true;
  }
  let bgRemoved = false;
  if (!hasTransparency(canvas)) { canvas = whiteToAlpha(canvas); bgRemoved = true; }
  return { canvas, trimmed, downscaled, bgRemoved };
}
// strip characters no filesystem wants, and trailing/leading dots/spaces
const sanitizeBase = (s) => (s || "").replace(/[\\/:*?"<>|\x00-\u001F]/g, "").replace(/^[\s.]+|[\s.]+$/g, "");

// Legacy-encoded filenames (Big5/GBK/UTF-8 bytes misread as Latin-1) surface as mojibake.
// Re-encode the string back to bytes and try decoders: a clean UTF-8 decode with real CJK
// wins outright (modern systems; its GBK misread would score more glyphs but is wrong),
// otherwise the legacy CJK decode with the best score: CJK glyphs earn, replacement
// chars pay (a truncated byte pair right before ".pdf" must not sink a good decode).
function repairMojibake(name) {
  if (!name) return name;
  name = name.normalize("NFC"); // macOS NFD decomposes accented mojibake into base + combining marks (> 0xFF) — compose first
  let suspect = 0;
  for (const ch of name) {
    const c = ch.codePointAt(0);
    if (c > 0xff) return name; // already real Unicode (e.g. CJK) — nothing to repair
    if (c >= 0x80) suspect++;
  }
  if (suspect < 2) return name; // plain ASCII: fine already
  const bytes = new Uint8Array([...name].map((ch) => ch.charCodeAt(0)));
  const score = (t) => {
    let cjk = 0, bad = 0;
    for (const ch of t) { const c = ch.codePointAt(0); if (c >= 0x3400 && c <= 0x9fff) cjk++; else if (c === 0xfffd) bad++; }
    return cjk * 2 - bad * 5;
  };
  try {
    const t = new TextDecoder("utf-8", { fatal: false }).decode(bytes);
    if (!t.includes("�") && score(t) >= 4) return t; // clean UTF-8 with 2+ CJK glyphs
  } catch { /* decoder unavailable */ }
  let best = null, bestScore = 3; // threshold: 2 clean CJK glyphs, so "résumé.pdf" stays put
  for (const enc of ["big5", "gb18030"]) {
    try {
      const t = new TextDecoder(enc, { fatal: false }).decode(bytes);
      const sc = score(t);
      if (sc > bestScore) { best = t; bestScore = sc; }
    } catch { /* decoder unavailable in this browser */ }
  }
  if (best) return best.replace(/�+$/g, ""); // drop a dangling truncated pair at the tail
  return name; // no confident repair: keep the original string
}

